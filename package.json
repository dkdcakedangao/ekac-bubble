{
  "name": "ekac-bubble",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win --dir --config.electronDist=node_modules/electron/dist --config.win.signExecutable=false && node scripts/zip.mjs",
    "check:asr": "tsx scripts/check-asr.ts",
    "check:packaged": "node scripts/check-packaged.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.1",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "local.ekacbubble.desktop",
    "productName": "ekac-bubble",
    "directories": {
      "output": "release/0.3.1"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "vendor/speech/data/**/*",
      "package.json",
      "README.md",
      "OSC开启位置.png",
      "MODEL_PROTOCOL.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx*/**/*",
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "web/assets/app.ico",
      "signExecutable": false
    },
    "artifactName": "ekac-bubble-${version}-win-x64.exe"
  },
  "description": "Local SenseVoice speech recognition, syllable voice and VRChat OSC subtitles",
  "author": "ekac-bubble contributors"
}
